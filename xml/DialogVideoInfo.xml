<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">8</defaultcontrol>
	<onload>SetProperty(infobackground,$ESCINFO[ListItem.Art(fanart)],home)</onload>
	<onunload>ClearProperty(infobackground,home)</onunload>
	<controls>
		<!-- FULLSCREEN FANART BACKGROUND -->
		<control type="image">
			<include>FullScreenDimensions</include>
			<depth>DepthBackground</depth>
			<texture background="true" fallback="DefaultVideo.png">$INFO[ListItem.Art(fanart)]</texture>
			<aspectratio>scale</aspectratio>
			<animation effect="fade" start="0" end="100" time="400">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
		</control>
		<!-- Fallback to tvshow fanart for episodes/seasons -->
		<control type="image">
			<include>FullScreenDimensions</include>
			<depth>DepthBackground</depth>
			<texture background="true">$INFO[ListItem.Art(tvshow.fanart)]</texture>
			<aspectratio>scale</aspectratio>
			<visible>String.IsEmpty(ListItem.Art(fanart))</visible>
			<animation effect="fade" start="0" end="100" time="400">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
		</control>

		<!-- LEFT-SIDE GRADIENT OVERLAY -->
		<control type="image">
			<depth>DepthContentPanel</depth>
			<left>-200</left>
			<top>0</top>
			<width>1200</width>
			<height>100%</height>
			<texture colordiffuse="C0000000" flipx="true">lists/contentpanel-fade.png</texture>
			<animation effect="fade" start="0" end="100" time="400">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
		</control>
		<!-- BOTTOM GRADIENT OVERLAY -->
		<control type="image">
			<depth>DepthContentPanel</depth>
			<include>FullScreenDimensions</include>
			<texture colordiffuse="D0000000">overlays/overlayfade.png</texture>
			<animation effect="fade" start="0" end="100" time="400">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
		</control>

		<!-- MAIN CONTENT -->
		<control type="group">
			<centertop>50%</centertop>
			<height>1080</height>
			<centerleft>50%</centerleft>
			<width>1920</width>
			<animation effect="fade" start="100" end="0" time="200" tween="sine" condition="Window.IsVisible(script-embuary-video.xml) | Window.IsVisible(script-embuary-person.xml) | Window.IsVisible(script-embuary-image.xml)">Conditional</animation>
			<animation effect="fade" start="0" end="100" time="400" delay="100">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>

			<!-- =================== -->
			<!-- LEFT INFO COLUMN    -->
			<!-- =================== -->
			<control type="group">
				<left>80</left>

				<!-- Clearlogo -->
				<control type="image">
					<top>100</top>
					<width>420</width>
					<height>160</height>
					<texture background="true">$INFO[ListItem.Art(clearlogo)]</texture>
					<aspectratio align="left" aligny="center">keep</aspectratio>
					<visible>!String.IsEmpty(ListItem.Art(clearlogo))</visible>
				</control>
				<!-- Fallback: tvshow clearlogo for episodes -->
				<control type="image">
					<top>100</top>
					<width>420</width>
					<height>160</height>
					<texture background="true">$INFO[ListItem.Art(tvshow.clearlogo)]</texture>
					<aspectratio align="left" aligny="center">keep</aspectratio>
					<visible>String.IsEmpty(ListItem.Art(clearlogo)) + !String.IsEmpty(ListItem.Art(tvshow.clearlogo))</visible>
				</control>
				<!-- Title text fallback when no clearlogo -->
				<control type="textbox">
					<top>110</top>
					<width>550</width>
					<height>130</height>
					<font>font52_title</font>
					<label>$VAR[VideoInfoMainLabelVar]</label>
					<shadowcolor>text_shadow</shadowcolor>
					<visible>String.IsEmpty(ListItem.Art(clearlogo)) + String.IsEmpty(ListItem.Art(tvshow.clearlogo))</visible>
				</control>

				<!-- Tagline -->
				<control type="label">
					<top>275</top>
					<width>600</width>
					<height>30</height>
					<font>font12</font>
					<textcolor>grey</textcolor>
					<shadowcolor>text_shadow</shadowcolor>
					<label>[I]$INFO[ListItem.Tagline][/I]</label>
					<visible>!String.IsEmpty(ListItem.Tagline)</visible>
				</control>

				<!-- Year | Duration | MPAA | Season/Episode -->
				<control type="grouplist">
					<top>310</top>
					<width>650</width>
					<height>32</height>
					<orientation>horizontal</orientation>
					<itemgap>20</itemgap>
					<control type="label">
						<width>auto</width>
						<height>32</height>
						<font>font12</font>
						<textcolor>unfocused_text</textcolor>
						<shadowcolor>text_shadow</shadowcolor>
						<label>$INFO[ListItem.Year]</label>
						<visible>!String.IsEmpty(ListItem.Year)</visible>
					</control>
					<control type="label">
						<width>auto</width>
						<height>32</height>
						<font>font12</font>
						<textcolor>grey</textcolor>
						<shadowcolor>text_shadow</shadowcolor>
						<label>$INFO[ListItem.Duration]</label>
						<visible>!String.IsEmpty(ListItem.Duration)</visible>
					</control>
					<control type="label">
						<width>auto</width>
						<height>32</height>
						<font>font12</font>
						<textcolor>grey</textcolor>
						<shadowcolor>text_shadow</shadowcolor>
						<label>$INFO[ListItem.Mpaa]</label>
						<visible>!String.IsEmpty(ListItem.Mpaa)</visible>
					</control>
					<control type="label">
						<width>auto</width>
						<height>32</height>
						<font>font12</font>
						<textcolor>grey</textcolor>
						<shadowcolor>text_shadow</shadowcolor>
						<label>Season $INFO[ListItem.Season], Episode $INFO[ListItem.Episode]</label>
						<visible>String.IsEqual(ListItem.DBType,episode)</visible>
					</control>
				</control>

				<!-- Ratings Badges Row -->
				<control type="grouplist">
					<top>355</top>
					<width>700</width>
					<height>40</height>
					<orientation>horizontal</orientation>
					<itemgap>18</itemgap>
					<visible>![Skin.HasSetting(Disable.RatingsINF) | String.IsEmpty(Skin.String(mdblist_api_key))]</visible>
					<!-- Metacritic -->
					<control type="grouplist">
						<width>90</width>
						<height>36</height>
						<orientation>horizontal</orientation>
						<itemgap>6</itemgap>
						<visible>![String.IsEmpty(Window(Home).Property(fentastic.metascore)) | Skin.HasSetting(Disable.MetacriticRating)]</visible>
						<control type="image">
							<width>24</width>
							<height>36</height>
							<aspectratio aligny="center">keep</aspectratio>
							<texture>$INFO[Window(Home).Property(fentastic.metascoreImage)]</texture>
						</control>
						<control type="label">
							<width max="60">auto</width>
							<height>36</height>
							<aligny>center</aligny>
							<font>font12</font>
							<textcolor>unfocused_text</textcolor>
							<shadowcolor>text_shadow</shadowcolor>
							<label>$INFO[Window(Home).Property(fentastic.metascore)]</label>
						</control>
					</control>
					<!-- RT Critic -->
					<control type="grouplist">
						<width>90</width>
						<height>36</height>
						<orientation>horizontal</orientation>
						<itemgap>6</itemgap>
						<visible>![String.IsEmpty(Window(Home).Property(fentastic.tomatoMeter)) | Skin.HasSetting(Disable.RTCRating)]</visible>
						<control type="image">
							<width>24</width>
							<height>36</height>
							<aspectratio aligny="center">keep</aspectratio>
							<texture>$INFO[Window(Home).Property(fentastic.tomatoImage)]</texture>
						</control>
						<control type="label">
							<width max="60">auto</width>
							<height>36</height>
							<aligny>center</aligny>
							<font>font12</font>
							<textcolor>unfocused_text</textcolor>
							<shadowcolor>text_shadow</shadowcolor>
							<label>$INFO[Window(Home).Property(fentastic.tomatoMeter)]</label>
						</control>
					</control>
					<!-- RT Audience -->
					<control type="grouplist">
						<width>90</width>
						<height>36</height>
						<orientation>horizontal</orientation>
						<itemgap>6</itemgap>
						<visible>![String.IsEmpty(Window(Home).Property(fentastic.tomatoUserMeter)) | Skin.HasSetting(Disable.RTARating)]</visible>
						<control type="image">
							<width>24</width>
							<height>36</height>
							<aspectratio aligny="center">keep</aspectratio>
							<texture>$INFO[Window(Home).Property(fentastic.tomatoUserImage)]</texture>
						</control>
						<control type="label">
							<width max="60">auto</width>
							<height>36</height>
							<aligny>center</aligny>
							<font>font12</font>
							<textcolor>unfocused_text</textcolor>
							<shadowcolor>text_shadow</shadowcolor>
							<label>$INFO[Window(Home).Property(fentastic.tomatoUserMeter)]</label>
						</control>
					</control>
					<!-- IMDb -->
					<control type="grouplist">
						<width>90</width>
						<height>36</height>
						<orientation>horizontal</orientation>
						<itemgap>6</itemgap>
						<visible>![String.IsEmpty(Window(Home).Property(fentastic.imdbRating)) | Skin.HasSetting(Disable.IMDbRating)]</visible>
						<control type="image">
							<width>24</width>
							<height>36</height>
							<aspectratio aligny="center">keep</aspectratio>
							<texture>$INFO[Window(Home).Property(fentastic.imdbImage)]</texture>
						</control>
						<control type="label">
							<width max="60">auto</width>
							<height>36</height>
							<aligny>center</aligny>
							<font>font12</font>
							<textcolor>unfocused_text</textcolor>
							<shadowcolor>text_shadow</shadowcolor>
							<label>$INFO[Window(Home).Property(fentastic.imdbRating)]</label>
						</control>
					</control>
					<!-- TMDb -->
					<control type="grouplist">
						<width>90</width>
						<height>36</height>
						<orientation>horizontal</orientation>
						<itemgap>6</itemgap>
						<visible>![String.IsEmpty(Window(Home).Property(fentastic.tmdbRating)) | Skin.HasSetting(Disable.TMDbRating)]</visible>
						<control type="image">
							<width>24</width>
							<height>36</height>
							<aspectratio aligny="center">keep</aspectratio>
							<texture>$INFO[Window(Home).Property(fentastic.tmdbImage)]</texture>
						</control>
						<control type="label">
							<width max="60">auto</width>
							<height>36</height>
							<aligny>center</aligny>
							<font>font12</font>
							<textcolor>unfocused_text</textcolor>
							<shadowcolor>text_shadow</shadowcolor>
							<label>$INFO[Window(Home).Property(fentastic.tmdbRating)]</label>
						</control>
					</control>
				</control>

				<!-- Genre -->
				<control type="label">
					<top>410</top>
					<width>600</width>
					<height>28</height>
					<font>font12</font>
					<textcolor>accent_color</textcolor>
					<shadowcolor>text_shadow</shadowcolor>
					<label>$INFO[ListItem.Genre]</label>
					<visible>!String.IsEmpty(ListItem.Genre)</visible>
				</control>

				<!-- SUMMARY heading -->
				<control type="label">
					<top>455</top>
					<width>600</width>
					<height>30</height>
					<font>font25_title</font>
					<textcolor>unfocused_text</textcolor>
					<shadowcolor>text_shadow</shadowcolor>
					<label>SUMMARY</label>
				</control>

				<!-- Plot area with clickable button overlay -->
				<control type="group" id="140">
					<top>495</top>
					<width>650</width>
					<height>140</height>
					<!-- Clickable plot button (opens text viewer) - with cast visible -->
					<control type="button" id="138">
						<width>650</width>
						<height>140</height>
						<label></label>
						<texturefocus></texturefocus>
						<texturenofocus></texturenofocus>
						<onclick condition="!String.IsEmpty(ListItem.Plot)">SetProperty(TextViewer_Header,$LOCALIZE[207],home)</onclick>
						<onclick condition="!String.IsEmpty(ListItem.Plot)">SetProperty(TextViewer_Text,$ESCINFO[ListItem.Plot],home)</onclick>
						<onclick condition="!String.IsEmpty(ListItem.Plot)">ActivateWindow(1102)</onclick>
						<onup>50</onup>
						<ondown>5000</ondown>
						<onleft>4000</onleft>
						<onright>4000</onright>
						<visible>Integer.IsGreater(Container(4000).NumItems,0)</visible>
					</control>
					<!-- Clickable plot button (opens text viewer) - no cast/metadata fallback -->
					<control type="button" id="139">
						<width>650</width>
						<height>140</height>
						<label></label>
						<texturefocus></texturefocus>
						<texturenofocus></texturenofocus>
						<onclick condition="!String.IsEmpty(ListItem.Plot)">SetProperty(TextViewer_Header,$LOCALIZE[207],home)</onclick>
						<onclick condition="!String.IsEmpty(ListItem.Plot)">SetProperty(TextViewer_Text,$ESCINFO[ListItem.Plot],home)</onclick>
						<onclick condition="!String.IsEmpty(ListItem.Plot)">ActivateWindow(1102)</onclick>
						<onup>50</onup>
						<ondown>5000</ondown>
						<onleft>4000</onleft>
						<onright>4000</onright>
						<visible>!Integer.IsGreater(Container(4000).NumItems,0)</visible>
					</control>
					<!-- Plot text overlay -->
					<control type="textbox">
						<width>650</width>
						<height>140</height>
						<font>font12</font>
						<textcolor>unfocused_text</textcolor>
						<shadowcolor>text_shadow</shadowcolor>
						<label fallback="19055">$INFO[ListItem.Plot]</label>
						<autoscroll delay="10000" time="5000" repeat="10000">Skin.HasSetting(AutoScroll)</autoscroll>
					</control>
				</control>
			</control>

			<!-- ========================== -->
			<!-- RIGHT-SIDE METADATA PANEL  -->
			<!-- ========================== -->
			<control type="group">
				<left>850</left>
				<top>100</top>
				<width>1000</width>
				<height>530</height>
				<include>OpenClose_Right</include>

				<!-- Semi-transparent panel background -->
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1000</width>
					<height>530</height>
					<texture border="21" colordiffuse="60000000">dialogs/dialog-bg.png</texture>
				</control>

				<!-- Poster thumbnail in panel -->
				<control type="group">
					<left>30</left>
					<top>30</top>
					<control type="image">
						<top>-8</top>
						<left>-8</left>
						<width>196</width>
						<height>286</height>
						<texture diffuse="masks/poster-50.png">colors/black.png</texture>
						<bordersize>10</bordersize>
					</control>
					<control type="image">
						<depth>DepthContentPopout</depth>
						<width>180</width>
						<height>270</height>
						<texture diffuse="masks/poster-50.png" fallback="DefaultVideo.png" background="true">$VAR[InfoDialogPosterVar]</texture>
					</control>
				</control>
				<!-- Music video thumbnail -->
				<control type="group">
					<left>30</left>
					<top>30</top>
					<visible>String.IsEqual(ListItem.DBType,musicvideo) + !Skin.HasSetting(show_musicvideoposter)</visible>
					<control type="image">
						<width>180</width>
						<height>270</height>
						<aspectratio>stretch</aspectratio>
						<texture diffuse="masks/poster-50.png" colordiffuse="FF555555">DefaultVideo.png</texture>
					</control>
					<control type="image">
						<width>180</width>
						<height>270</height>
						<aspectratio>keep</aspectratio>
						<texture diffuse="masks/poster-50.png">$INFO[ListItem.Thumb]</texture>
					</control>
				</control>

				<!-- Metadata list -->
				<control type="grouplist" id="4000">
					<orientation>vertical</orientation>
					<left>240</left>
					<top>30</top>
					<width>730</width>
					<height>470</height>
					<itemgap>-8</itemgap>
					<ondown>5000</ondown>
					<onup>50</onup>
					<onright>140</onright>
					<onleft>140</onleft>
					<include content="InfoDialogMetadata">
						<param name="control_id" value="147" />
						<param name="label" value="$INFO[ListItem.Director,$LOCALIZE[20339]: ]" />
						<param name="altlabel" value="$INFO[ListItem.Director,$LOCALIZE[20339]: ]" />
						<param name="onclick_condition" value="System.AddonIsEnabled(script.embuary.info)" />
						<param name="onclick" value="RunScript(script.embuary.info,call=person,query='$ESCINFO[ListItem.Director]')" />
						<param name="altclick_condition" value="System.AddonIsEnabled(script.embuary.info)" />
						<param name="altclick" value="RunScript(script.embuary.info,call=person,query='$ESCINFO[ListItem.Director]')" />
						<param name="visible" value="!String.IsEmpty(ListItem.Director)" />
					</include>
					<include content="InfoDialogMetadata">
						<param name="control_id" value="148" />
						<param name="label" value="$INFO[ListItem.Writer,$LOCALIZE[20417]: ]" />
						<param name="altlabel" value="$INFO[ListItem.Writer,$LOCALIZE[20417]: ]" />
						<param name="onclick_condition" value="System.AddonIsEnabled(script.embuary.info)" />
						<param name="onclick" value="RunScript(script.embuary.info,call=person,query='$ESCINFO[ListItem.Writer]')" />
						<param name="altclick_condition" value="System.AddonIsEnabled(script.embuary.info)" />
						<param name="altclick" value="RunScript(script.embuary.info,call=person,query='$ESCINFO[ListItem.Writer]')" />
						<param name="visible" value="!String.IsEmpty(ListItem.Writer)" />
					</include>
					<include content="InfoDialogMetadata">
						<param name="control_id" value="149" />
						<param name="label" value="$LOCALIZE[563]: $INFO[ListItem.RatingAndVotes]" />
						<param name="altlabel" value="$LOCALIZE[563]: $INFO[ListItem.RatingAndVotes]" />
						<param name="visible" value="!String.IsEmpty(ListItem.RatingAndVotes)" />
					</include>
					<include content="InfoDialogMetadata">
						<param name="control_id" value="150" />
						<param name="label" value="$LOCALIZE[515]: $INFO[ListItem.Genre]" />
						<param name="altlabel" value="$LOCALIZE[515]: $INFO[ListItem.Genre]" />
						<param name="visible" value="!String.IsEmpty(ListItem.Genre) + [String.IsEqual(ListItem.DBType,musicvideo) | String.IsEqual(ListItem.DBType,movie)]" />
					</include>
					<include content="InfoDialogMetadata">
						<param name="control_id" value="152" />
						<param name="label" value="$LOCALIZE[21875]: $INFO[ListItem.Country]" />
						<param name="altlabel" value="$LOCALIZE[21875]: $INFO[ListItem.Country]" />
						<param name="visible" value="!String.IsEmpty(ListItem.Country)" />
					</include>
					<include content="InfoDialogMetadata">
						<param name="control_id" value="153" />
						<param name="label" value="$LOCALIZE[29909]: $INFO[ListItem.Studio]" />
						<param name="altlabel" value="$LOCALIZE[29909]: $INFO[ListItem.Studio]" />
						<param name="visible" value="!String.IsEmpty(ListItem.Studio)" />
					</include>
					<include content="InfoDialogMetadata">
						<param name="control_id" value="154" />
						<param name="label" value="$VAR[FirstAiredLabel]: $INFO[ListItem.Premiered]" />
						<param name="altlabel" value="$VAR[FirstAiredLabel]: $INFO[ListItem.Premiered]" />
						<param name="visible" value="!String.IsEmpty(ListItem.Premiered)" />
					</include>
					<include content="InfoDialogMetadata">
						<param name="control_id" value="155" />
						<param name="label" value="[COLOR button_focus2]$LOCALIZE[31048]: $INFO[ListItem.Season,, $LOCALIZE[36905]]$INFO[ListItem.Episode, (, $LOCALIZE[20453])]" />
						<param name="altlabel" value="$LOCALIZE[31048]: $INFO[ListItem.Season,, $LOCALIZE[36905]]$INFO[ListItem.Episode, (, $LOCALIZE[20453])]" />
						<param name="visible" value="!String.IsEmpty(ListItem.Season) + !String.IsEqual(ListItem.DBType,episode)" />
					</include>
					<include content="InfoDialogMetadata">
						<param name="control_id" value="156" />
						<param name="label" value="$LOCALIZE[31017]: $INFO[ListItem.Mpaa]" />
						<param name="altlabel" value="$LOCALIZE[31017]: $INFO[ListItem.Mpaa]" />
						<param name="visible" value="!String.IsEmpty(ListItem.Mpaa)" />
					</include>
					<include content="InfoDialogMetadata">
						<param name="control_id" value="157" />
						<param name="label" value="$LOCALIZE[20457]: $INFO[ListItem.Set]" />
						<param name="altlabel" value="$LOCALIZE[20457]: $INFO[ListItem.Set]" />
						<param name="visible" value="!String.IsEmpty(ListItem.Set)" />
					</include>
					<include content="InfoDialogMetadata">
						<param name="control_id" value="158" />
						<param name="label" value="$LOCALIZE[20459]: $INFO[ListItem.Tag]" />
						<param name="altlabel" value="$LOCALIZE[20459]: $INFO[ListItem.Tag]" />
						<param name="visible" value="!String.IsEmpty(ListItem.Tag)" />
					</include>
					<include content="InfoDialogMetadata">
						<param name="control_id" value="159" />
						<param name="label" value="$LOCALIZE[126]: $INFO[ListItem.Status]" />
						<param name="altlabel" value="$LOCALIZE[126]: $INFO[ListItem.Status]" />
						<param name="visible" value="!String.IsEmpty(ListItem.Status)" />
					</include>
					<include content="InfoDialogMetadata">
						<param name="control_id" value="161" />
						<param name="label" value="$LOCALIZE[570]: $INFO[ListItem.DateAdded]" />
						<param name="altlabel" value="$LOCALIZE[570]: $INFO[ListItem.DateAdded]" />
						<param name="visible" value="!String.IsEmpty(ListItem.DateAdded) + [String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,movie) | String.IsEqual(ListItem.DBType,musicvideo) | String.IsEqual(ListItem.DBType,video)]" />
					</include>
					<include content="InfoDialogMetadata">
						<param name="control_id" value="163" />
						<param name="label" value="$LOCALIZE[576]: $INFO[ListItem.PlayCount]" />
						<param name="altlabel" value="$LOCALIZE[576]: $INFO[ListItem.PlayCount]" />
						<param name="visible" value="!String.IsEmpty(ListItem.PlayCount)" />
					</include>
					<include content="InfoDialogMetadata">
						<param name="control_id" value="164" />
						<param name="label" value="$LOCALIZE[568]: $INFO[ListItem.LastPlayed]" />
						<param name="altlabel" value="$LOCALIZE[568]: $INFO[ListItem.LastPlayed]" />
						<param name="visible" value="!String.IsEmpty(ListItem.LastPlayed)" />
					</include>
					<include content="InfoDialogMetadata">
						<param name="control_id" value="165" />
						<param name="label" value="$LOCALIZE[564]: $INFO[ListItem.DBType]" />
						<param name="altlabel" value="$LOCALIZE[564]: $INFO[ListItem.DBType]" />
						<param name="visible" value="!String.IsEmpty(ListItem.DBType)" />
					</include>
				</control>
			</control>

			<!-- ========================= -->
